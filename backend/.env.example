# Copie este arquivo para ".env" e ajuste os valores conforme seu Postgres local

# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/econofinance

# Qualquer texto longo e aleatório — usado para assinar os tokens JWT
JWT_SECRET=troque-por-um-valor-aleatorio-e-secreto

PORT=3000
NODE_ENV=development
